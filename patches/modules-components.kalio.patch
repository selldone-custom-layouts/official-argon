+/** Kalio: a filter as the "filter" watcher writes it to the address (empty
+ *  parts and prices dropped), so the $route watcher can tell the list's own
+ *  writes from a link that changed the filter. */
+function kalioFilterQuery(obj: any): any {
+  const out: any = {};
+  Object.keys(obj || {}).forEach((k) => {
+    if (k === "prices") return;
+    if (Array.isArray(obj[k])) {
+      if (obj[k].length) out[k] = obj[k];
+    } else if (obj[k] && typeof obj[k] === "object") {
+      const r = kalioFilterQuery(obj[k]);
+      if (r && Object.keys(r).length) out[k] = r;
+    } else if (obj[k]) {
+      out[k] = obj[k];
+    }
+  });
+  return out;
+}
